[Unit]
Description=C-Tunnel agent (tunnel benchmark responder and failover)
After=network-online.target
Wants=network-online.target

StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/bin/ctunnel agent
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
